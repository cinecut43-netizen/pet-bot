# Токен от @BotFather
BOT_TOKEN=
# Telegram id админов через запятую — им доступна команда /stats (узнать свой id: @userinfobot)
ADMIN_IDS=
# Контакт для вопросов о персональных данных — показывается в /privacy (например, @username или почта)
PRIVACY_CONTACT=

# Пароль базы данных (для docker compose). Поменяйте перед запуском на сервере.
POSTGRES_PASSWORD=pet
# Без Docker укажите адрес базы сами:
# DATABASE_URL=postgresql://pet:pet@localhost:5432/pet

# --- Только если сервер не может достучаться до нужных сайтов ---
# Прокси до api.telegram.org, например socks5://user:pass@host:1080 или http://host:3128
TELEGRAM_PROXY=
# Свой Local Bot API Server вместо api.telegram.org, например http://localhost:8081
TELEGRAM_API_URL=
# Зеркало Docker Hub, если образы не скачиваются, например mirror.gcr.io
DOCKER_REGISTRY=docker.io
# Зеркало PyPI, если не ставятся пакеты Python
PIP_INDEX_URL=https://pypi.org/simple
